<Project>
  <PropertyGroup>
    <!-- Library, tests and bench ship/run on net8.0 and net10.0 (ADR-019; bench per ADR-020).
         Every other project (tools/GoldenKit) stays net10.0 only. -->
    <EmlMultiTarget Condition="'$(MSBuildProjectName)' == 'EmlExtraction' or '$(MSBuildProjectName)' == 'EmlExtraction.Tests' or '$(MSBuildProjectName)' == 'EmlExtraction.Bench'">true</EmlMultiTarget>
    <TargetFrameworks Condition="'$(EmlMultiTarget)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(EmlMultiTarget)' != 'true'">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
