<Project>
  <PropertyGroup>
    <!-- Library, tests and bench ship/run on net8.0 and net10.0 (ADR-019; bench per ADR-020).
         RealisticSamples too, because the tests reference it.
         Every other project (tools/GoldenKit) stays net10.0 only. -->
    <EmlMultiTarget Condition="'$(MSBuildProjectName)' == 'EmlExtraction' or '$(MSBuildProjectName)' == 'EmlExtraction.Tests' or '$(MSBuildProjectName)' == 'EmlExtraction.Bench' or '$(MSBuildProjectName)' == 'RealisticSamples'">true</EmlMultiTarget>
    <TargetFrameworks Condition="'$(EmlMultiTarget)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <TargetFramework Condition="'$(EmlMultiTarget)' != 'true'">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Analyzer enforcement (ydk ADR 0003, dotnet-webapi-clean analyzer enforcement).
    Rule severities live in .editorconfig. YdkAnalyzersAsErrors is the single switch that turns
    analyzer/compiler warnings into build errors; set it to false (here, or per build with
    `dotnet build -p:YdkAnalyzersAsErrors=false`) to run warn-only while retrofitting.
    Only the exact value `true` enables warnings-as-errors.
  -->
  <PropertyGroup>
    <YdkAnalyzersAsErrors Condition="'$(YdkAnalyzersAsErrors)' == ''">true</YdkAnalyzersAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(YdkAnalyzersAsErrors)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version pinned centrally in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
