<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>EmlExtraction</PackageId>
    <Version>0.1.0</Version>
    <Authors>yoavarad</Authors>
    <Description>Detects RFC 822/5322 mail and extracts metadata, main content and attachments from EML files. Built on MimeKit.</Description>
    <PackageTags>eml;email;mime;rfc5322;extraction</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/yoavarad/eml-extractor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Extract(MimeMessage) is internal (ADR-012); GoldenKit's probe uses it. -->
    <InternalsVisibleTo Include="GoldenKit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MimeKit" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>
