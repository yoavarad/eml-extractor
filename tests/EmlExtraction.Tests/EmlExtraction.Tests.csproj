<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EmlExtraction\EmlExtraction.csproj" />
    <ProjectReference Include="..\..\tools\RealisticSamples\RealisticSamples.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Single golden schema, shared with GoldenKit. -->
    <Compile Include="..\..\tools\GoldenKit\Schema\*.cs" Link="GoldenSchema\%(Filename)%(Extension)" />
    <Using Include="GoldenKit.Schema" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure parts of the bench DOP sweep (ADR-015), unit-tested without referencing the bench exe. -->
    <Compile Include="..\..\benches\EmlExtraction.Bench\Sweep\SweepMath.cs" Link="Sweep\SweepMath.cs" />
    <Compile Include="..\..\benches\EmlExtraction.Bench\Sweep\SweepReport.cs" Link="Sweep\SweepReport.cs" />
    <Compile Include="..\..\benches\EmlExtraction.Bench\Sweep\BaselineCompare.cs" Link="Sweep\BaselineCompare.cs" />
    <Compile Include="..\..\benches\EmlExtraction.Bench\Sweep\CompareCommand.cs" Link="Sweep\CompareCommand.cs" />
    <Compile Include="..\..\benches\EmlExtraction.Bench\Sweep\CpuInfoParser.cs" Link="Sweep\CpuInfoParser.cs" />
    <Compile Include="..\..\benches\EmlExtraction.Bench\Sweep\MboxSplitter.cs" Link="Sweep\MboxSplitter.cs" />
    <Compile Include="..\..\benches\EmlExtraction.Bench\Sweep\LargeFileMath.cs" Link="Sweep\LargeFileMath.cs" />
    <!-- Pure parts of the per-stage profiling harness (ADR-020). -->
    <Compile Include="..\..\benches\EmlExtraction.Bench\Profile\ProfileMath.cs" Link="Profile\ProfileMath.cs" />
  </ItemGroup>
</Project>
